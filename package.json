{
  "name": "studio",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:ui": "bun run --cwd packages/rockin build",
    "dev:studio": "bun run build:ui && bun run --cwd apps/studio dev",
    "build:studio": "bun run build:ui && bun run --cwd apps/studio build",
    "typecheck:studio": "bun run --cwd apps/studio typecheck",
    "build": "bun run build:ui",
    "typecheck": "bun run --cwd packages/rockin typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "dependencies": {
    "rockin": "workspace:*"
  }
}
