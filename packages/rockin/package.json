{
  "name": "rockin",
  "version": "0.0.19",
  "description": "Reusable React UI components, hooks, icons, utilities, and styles for Rock Star projects.",
  "keywords": [
    "react",
    "react-components",
    "ui",
    "component-library",
    "design-system",
    "typescript",
    "nextjs",
    "tailwindcss",
    "shadcn",
    "hooks",
    "icons"
  ],
  "author": {
    "name": "Rock Star",
    "url": "https://rockstar.bio"
  },
  "type": "module",
  "private": false,
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#components/*": "./src/ui/*.tsx",
    "#hooks/*": "./src/hooks/*.ts",
    "#lib/*": "./src/lib/*.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cn": {
      "types": "./dist/cn.d.ts",
      "import": "./dist/cn.js"
    },
    "./loader": {
      "types": "./dist/loader.d.ts",
      "import": "./dist/loader.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "import": "./dist/provider.js"
    },
    "./lucide": {
      "types": "./dist/lucide.d.ts",
      "import": "./dist/lucide.js"
    },
    "./gravity": {
      "types": "./dist/gravity.d.ts",
      "import": "./dist/gravity.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./icon": {
      "types": "./dist/icon/index.d.ts",
      "import": "./dist/icon/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js"
    },
    "./lib": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    },
    "./utils/parms-client": {
      "types": "./dist/utils/parms-client.d.ts",
      "import": "./dist/utils/parms-client.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rockstar-bio/rockin.git"
  },
  "homepage": "https://github.com/rockstar-bio/rockin#readme",
  "bugs": {
    "url": "https://github.com/rockstar-bio/rockin/issues"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsup",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@ariakit/react": "^0.4.40",
    "@base-ui/react": "^1.6.0",
    "@bprogress/next": "^3.2.12",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@gravity-ui/icons": "^2.3.0",
    "@ncdai/react-swipe-actions": "^0.3.0",
    "@number-flow/react": "^0.6.2",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@shadcn/react": "^0.3.0",
    "@visx/curve": "4.0.1-alpha.0",
    "@visx/event": "4.0.1-alpha.0",
    "@visx/gradient": "4.0.1-alpha.0",
    "@visx/grid": "4.0.1-alpha.0",
    "@visx/responsive": "4.0.1-alpha.0",
    "@visx/scale": "4.0.1-alpha.0",
    "@visx/shape": "4.0.1-alpha.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "d3-array": "^3.2.4",
    "d3-shape": "^3.2.0",
    "embla-carousel-react": "^8.6.0",
    "feral-blob": "^0.2.0",
    "goey-toast": "^0.5.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.27.0",
    "motion": "^12.42.2",
    "next-themes": "^0.4.6",
    "nuqs": "^2.9.4",
    "openai": "^7.4.0",
    "qrcode": "^1.5.4",
    "react-hotkeys-hook": "^5.3.3",
    "react-resizable-panels": "^4.13.3",
    "recharts": "^3.8.0",
    "shadcn": "^4.13.0",
    "shiki": "^4.4.3",
    "sonner": "^2.0.7",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "next": "^16.0.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tsup": "^8.5.0",
    "typescript": "^5"
  }
}
